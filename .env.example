# ============================================================================
# K9 Operations — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: a default location UUID for single-tenant builds (the app normally uses
# the signed-in profile's location). Leave blank for multi-tenant.
VITE_DEFAULT_LOCATION_ID=

# ── Highlight.io (optional, for session replay + in-browser annotations) ─────
# Get a free Project ID at https://app.highlight.io
# Used for live feedback/annotations directly in the running app (no browser extension needed).
VITE_HIGHLIGHT_PROJECT_ID=your_highlight_project_id_here

# Browser-side Google Places autocomplete for Grassroots event addresses.
# Use a restricted browser key. Do not commit a real key here.
VITE_GOOGLE_PLACES_API_KEY=your_restricted_google_places_browser_key_here

# Server-side OpenWeather key for the weather-daily Supabase Edge Function.
# OpenWeather One Call 3.0 is used server-side for current, forecast, hourly,
# daily aggregation, historical daily data, alerts, and AI weather overview.
# Set this as a Supabase secret, not as a VITE_* browser variable:
#   supabase secrets set OPENWEATHER_API_KEY=your_openweather_key_here
OPENWEATHER_API_KEY=your_openweather_key_here

# Supabase Edge Function secrets for performance review signing.
# Keep these server-side; never expose them as VITE_* values.
DOCUSEAL_API_KEY=your_docuseal_api_key_here
DOCUSEAL_BASE_URL=https://api.docuseal.com
DOCUSEAL_WEBHOOK_SECRET=choose-a-long-random-webhook-url-secret

# ── xAI / Grok (Supabase Edge Function secrets) ─────────────────────────────
# Interview Assistant transcription and drafting run server-side.
# Set these in Supabase, not in the frontend Vite environment:
#   supabase secrets set XAI_API_KEY=xai-your-key-here
# Optional model overrides:
#   supabase secrets set INTERVIEW_XAI_STT_MODEL=grok-stt
#   supabase secrets set INTERVIEW_XAI_DRAFT_MODEL=grok-4.20-0309-reasoning

# ── Stripe (for payment processing) ─────────────────────────────────────────
# These are NOT used in the frontend Vite build.
# They are set as Supabase Edge Function secrets.
#
# HOW TO SET UP STRIPE:
#
# 1. Create a Stripe account at https://stripe.com
# 2. Get your Secret Key from https://dashboard.stripe.com/apikeys
# 3. Create 3 subscription products + prices in Stripe:
#    - Starter:    $149/month  → copy the price ID (price_...)
#    - Growth:     $349/month  → copy the price ID (price_...)
#    - Scale:      $799/month  → copy the price ID (price_...)
#    - Enterprise: custom      → create a price or handle manually
#
# 4. Set the secrets in Supabase:
#    supabase secrets set STRIPE_SECRET_KEY=sk_live_your_key_here
#    supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
#    supabase secrets set STRIPE_PRICE_SINGLE=price_starter_id_here
#    supabase secrets set STRIPE_PRICE_MULTI_3=price_growth_id_here
#    supabase secrets set STRIPE_PRICE_MULTI_10=price_scale_id_here
#    supabase secrets set STRIPE_PRICE_ENTERPRISE=price_enterprise_id_here
#
# 5. Set up the webhook endpoint in Stripe Dashboard:
#    URL: https://your-project.supabase.co/functions/v1/stripe-webhook
#    Events to listen for:
#      - checkout.session.completed
#      - customer.subscription.updated
#      - customer.subscription.deleted
#      - invoice.payment_failed
#
# 6. Copy the webhook signing secret (whsec_...) from Stripe Dashboard
#    and set it via: supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#
# 7. Deploy the edge functions:
#    supabase functions deploy stripe-checkout
#    supabase functions deploy stripe-webhook
#
# 8. Run the location_limit migration:
#    Apply supabase/migrations/20260319_subscriptions_add_location_limit.sql
#
# That's it! The signup → plan selection → checkout → role assignment flow
# will work automatically.

# ── Twilio (SMS — customer-portal OTP + reminders, Edge Function secrets) ────
#   supabase secrets set TWILIO_ACCOUNT_SID=your_account_sid
#   supabase secrets set TWILIO_AUTH_TOKEN=your_auth_token
#   supabase secrets set TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
#   supabase secrets set TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid   # if using Verify

# ── Resend (inbound lead email → Ignite webhook, Edge Function secrets) ─────
#   supabase secrets set RESEND_API_KEY=your_resend_api_key
#   supabase secrets set RESEND_FROM_EMAIL=notifications@yourdomain.com
#   supabase secrets set RESEND_REPLY_TO_DEFAULT=reply@yourdomain.com
#   supabase secrets set IGNITE_INBOUND_ADDRESS=leads@inbound.yourdomain.com
#   supabase secrets set IGNITE_HEALTHCHECK_FROM=health@yourdomain.com        # optional

# ── LLM providers (Edge Function secrets — never VITE_*) ─────────────────────
#   supabase secrets set OPENAI_API_KEY=sk-...           # breed-detect, breed-detect-bulk, nlp-query
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...    # ai-assistant, breed-compare, nlp-query

# ── Stytch (planned SMS OTP alternative — Edge Function secrets) ─────────────
#   supabase secrets set STYTCH_PROJECT_ID=project-...
#   supabase secrets set STYTCH_SECRET=secret-...
#   supabase secrets set STYTCH_ENVIRONMENT=test            # or live

# ── Vercel serverless API routes (api/*) — server env, NOT VITE_* ───────────
# These read SUPABASE_URL / SUPABASE_ANON_KEY (falling back to the VITE_* values).
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_ANON_KEY=your_anon_key_here

# ── Tenant config for cron-driven Edge Functions (Supabase secrets) ─────────
# Used by compute-scheduling-matrix / scheduling-matrix-backfill / ops-platform-health
# to resolve the default location + Gingr subdomain (no longer hardcoded):
#   supabase secrets set DEFAULT_LOCATION_ID=<your-location-uuid>
#   supabase secrets set DEFAULT_GINGR_SUBDOMAIN=<your-gingr-subdomain>

# ── Operational toggles / local scripts ─────────────────────────────────────
#   SCHEDULING_COMPUTE_DISABLED=false     # kill-switch for compute-scheduling-matrix
#   SUPABASE_SERVICE_ROLE_KEY=...         # local seed/admin scripts ONLY (never in the browser)
#   SUPABASE_URL=... / LOCATION_ID=...    # for scripts/seed_inventory.mjs, reconcile-cron-jobs.mjs
# ============================================================================
